# Public Dublin City Council open-data credentials, published on:
# https://data.gov.ie/dataset/sonitus
# https://data.smartdublin.ie/dataset/sonitus
# Do not commit a filled .env file.

SONITUS_USERNAME=dublincityapi
SONITUS_PASSWORD=Xpa5vAQ9ki
SONITUS_BASE_URL=https://data.smartdublin.ie/sonitus-api
SONITUS_TIMEOUT_SECONDS=60

# Groq chat completions (server-side). Leave empty locally if unused.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Signed session cookie (generate a long random string). Not a Google secret.
SESSION_SECRET=

# Google OAuth (Web application client). Never put these in frontend JS.
# Leave empty to use Calendar Demo mode only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
